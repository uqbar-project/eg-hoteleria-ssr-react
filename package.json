{
  "name": "eg-hoteleria-ssr-react",
  "private": true,
  "scripts": {
    "dev:remix": "pnpm --filter remix dev",
    "dev:remix:watch": "pnpm --filter remix dev",
    "dev:vanilla": "pnpm --filter vanilla dev",
    "dev:vanilla:watch": "pnpm --filter vanilla dev:watch",
    "build:remix": "pnpm --filter remix build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/jsdom": "30.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
